node_modules

# Raw Natural Earth downloads + intermediate mapshaper output — large, fully regenerable via
# `npm run fetch:geo && npm run build:geo`. Only the processed output under src/data/geo/ is
# committed.
scripts/geo/.raw
scripts/geo/.tmp

# Mobile (Phase E): the Capacitor web bundle (`npm run build:mobile`) is a regenerable build
# artifact copied into android/ and ios/ by `npx cap sync` — unlike docs/ (committed, for GitHub
# Pages hosting), this one is never meant to be served or committed directly.
www

# Playwright (plan §13's "Playability" e2e check) — run output, never source.
test-results
playwright-report
blob-report

# Phase F server-authoritative resolution (plan §10): the Supabase Edge Function's bundled engine,
# regenerable via `npm run build:edge` (scripts/build-edge-engine.mjs) — never hand-edited.
supabase/functions/resolve-turn/_engine.bundle.js

# Downloaded CC0 model packs (src/assets/raw-models/README.md): large, and fully regenerable into
# src/assets/units/ by `npm run import:models`. Only the README and the optional manifest are kept.
src/assets/raw-models/*
!src/assets/raw-models/README.md
!src/assets/raw-models/units.manifest.example.json

# Blender unit builds (scripts/blender/ti_units.py out_dir): editable sources and uncompressed GLBs,
# delivered as release ZIPs; only the packed game copy goes into src/assets/units.
art-build/
dist/
