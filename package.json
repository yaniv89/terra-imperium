{
  "name": "terra-imperium",
  "version": "0.1.0",
  "description": "Terra Imperium - A grand strategy country/army sim spanning 2000 BCE - 2300 CE on a real Earth globe. Play any of 240 nations.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node --max-old-space-size=8192 scripts/build.mjs",
    "import:models": "node scripts/import-models.js",
    "pack:models": "node scripts/art/pack-map-models.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d docs",
    "fetch:geo": "node scripts/geo/fetch-raw.mjs",
    "build:geo": "node scripts/geo/build.mjs",
    "fetch:tiles": "node scripts/geo/fetch-tiles-raw.mjs",
    "build:tiles": "node scripts/geo/build-tiles.mjs && node scripts/geo/build-tile-terrain.mjs && node scripts/geo/build-tiles-bin.mjs",
    "build:terrain": "node scripts/geo/build-tile-terrain.mjs && node scripts/geo/build-tiles-bin.mjs",
    "build:tiles-bin": "node scripts/geo/build-tiles-bin.mjs",
    "build:raster": "node scripts/geo/build-world-raster.mjs",
    "build:pyramid": "node scripts/geo/build-raster-pyramid.mjs",
    "build:capitals": "node scripts/geo/build-country-capitals.mjs",
    "build:world-regions": "node scripts/geo/build-country-capitals.mjs && node scripts/geo/build-world-regions.mjs",
    "build:mobile": "node --max-old-space-size=8192 scripts/build.mjs --mobile",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "build:edge": "node scripts/build-edge-engine.mjs",
    "audit:scenarios": "node scripts/audit-scenarios.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@supabase/supabase-js": "^2.116.0",
    "d3-geo": "^3.1.1",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "lucide-react": "^0.263.1",
    "polygon-clipping": "^0.15.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-globe.gl": "^2.38.0",
    "three": "^0.186.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@iconify-json/game-icons": "^1.2.4",
    "@playwright/test": "^1.63.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "cities.json": "^1.1.61",
    "esbuild": "^0.28.2",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "gh-pages": "^6.3.0",
    "gltfpack": "^1.3.0",
    "koppen-climate-lookup": "^2.0.0",
    "mapshaper": "^0.7.61",
    "postcss": "^8.4.27",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.3.3",
    "vite": "^4.4.5",
    "vitest": "^4.1.10",
    "world-countries": "^5.1.0"
  }
}
